# Copy this file to .env and replace the placeholders.
SNOWFLAKE_ACCOUNT=my_org-my_account
SNOWFLAKE_USER=my_user
SNOWFLAKE_PASSWORD=my_password
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=NYC_TAXI_WH
SNOWFLAKE_DATABASE=NYC_TAXI

# Required assignment range (20 months).
TAXI_START_MONTH=2025-01
TAXI_END_MONTH=2026-08

# Local Kestra UI/API login. Change these values outside a classroom environment.
KESTRA_ADMIN_EMAIL=admin@localhost.dev
KESTRA_ADMIN_PASSWORD=KestraLab2026!
